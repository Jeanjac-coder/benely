# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service: serveur uniquement (webhook de paiement, tâche planifiée, administration). Ne jamais l'exposer au navigateur.
SUPABASE_SERVICE_ROLE_KEY=

# IA
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
BENELY_WEB_RESEARCH=0

# Paiement (CinetPay). En développement: BILLING_PROVIDER=simulation (ignoré en production).
BILLING_PROVIDER=cinetpay
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
# Secret de la tâche planifiée /api/cron/billing (en-tête Authorization: Bearer ...)
CRON_SECRET=

# Mentions du vendeur sur les factures
BENELY_LEGAL_NAME=
BENELY_LEGAL_ADDRESS=
BENELY_LEGAL_IDS=
BENELY_LEGAL_CONTACT=
BENELY_VAT_NOTE=

# Taux indicatif pour comparer coût IA (USD) et prix des offres (FCFA) dans l'administration
USD_TO_XOF=600
